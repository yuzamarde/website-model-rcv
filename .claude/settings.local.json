{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/additive-only-guard.js",
            "timeout": 10,
            "statusMessage": "Checking additive-only response shapes..."
          }
        ]
      }
    ]
  }
}
